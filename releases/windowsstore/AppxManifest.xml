<?xml version="1.0" encoding="utf-8"?>
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
         xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
         IgnorableNamespaces="uap uap5 rescap">

  <Identity Name="Geiger.DokuReader"
            Publisher="CN=52596601-BAB4-4F3F-B182-E8F3F273B202"
            Version="1.0.1.0"
            ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>DokuReader</DisplayName>
    <PublisherDisplayName>Geiger</PublisherDisplayName>
    <Description>Lokale Dokumentenbibliothek mit Vorschau, Lesestatus, Sammel-PDF und Companion-JSON-Abgleich.</Description>
    <Logo>icons\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop"
                        MinVersion="10.0.17763.0"
                        MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="de-DE" />
    <Resource Language="en-US" />
    <Resource Language="es-ES" />
    <Resource Language="zh-CN" />
    <Resource Language="ja-JP" />
    <Resource Language="ru-RU" />
  </Resources>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>

  <Applications>
    <Application Id="DokuReaderApp"
                 Executable="DokuReader.exe"
                 EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="DokuReader"
                          Description="Lokale Dokumentenbibliothek mit Vorschau, Lesestatus, Sammel-PDF und Companion-JSON-Abgleich."
                          Square150x150Logo="icons\Square150x150Logo.png"
                          Square44x44Logo="icons\Square44x44Logo.png"
                          BackgroundColor="transparent">
        <uap:DefaultTile Wide310x150Logo="icons\Wide310x150Logo.png"
                         Square310x310Logo="icons\Square310x310Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <uap5:Extension Category="windows.appExecutionAlias"
                        Executable="DokuReader.exe"
                        EntryPoint="Windows.FullTrustApplication">
          <uap5:AppExecutionAlias>
            <uap5:ExecutionAlias Alias="dokureader.exe" />
          </uap5:AppExecutionAlias>
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>
</Package>

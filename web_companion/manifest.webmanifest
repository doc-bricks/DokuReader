{
  "name": "DokuReader Companion",
  "short_name": "DokuReader",
  "description": "Read-only-Ansicht der DokuReader-Bibliothek auf Mobilgeräten und im Browser.",
  "id": "./",
  "scope": "./",
  "start_url": "./",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui",
    "browser"
  ],
  "orientation": "any",
  "background_color": "#f5f5f5",
  "theme_color": "#1976d2",
  "lang": "de",
  "icons": [
    {
      "src": "./icons/Icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "./icons/Icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "./icons/Icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "./icons/Icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
